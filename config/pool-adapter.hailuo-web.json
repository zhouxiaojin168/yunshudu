{
  "_note": "乙路-国内站 hailuoai.com（build prod-zh-0.1.796/0.1.797） 网页端适配器（https://hailuoai.com）：签名=header token + header yy + 公共参数（scripts/hailuo-sign.js）。账号 token 形如 \"<_token>|<uuid>|<device_id>\"。 R140: query.url_path -> array, prefers aiWatermarkURL (no bottom brand banner; only the small corner tag, which dewatermark.ps1 can erase).",
  "_verify": [
    "★R83 生产实测（真号 周孝金，80 贝壳）：同一签名器在国内站 7/7 HTTP 200 code=0。",
    "★国内站图片模型：image-01(1 credit) / **all-in-one-image-pro**(=海外 nano-banana2 同款，1K/2K=6、4K=10 credit，13 模型之一)。",
    "★国内站签到：无接口；免费额度=一次性新人礼 credit_type=3，80 贝壳，到期 1792079999999 = 2026-10-15。"
  ],
  "_http_notes": [
    "★ 生图 body 的 resolution / aspectRatio / quality 必须是 **valueStr 字符串**：resolution ∈ {\"1K\",\"2K\",\"4K\"}，aspectRatio ∈ {\"Auto\",\"9:16\",\"16:9\",...}，quality=\"medium\"（无 qualities 的模型）。发数字会 HTTP 400 bind body failed。",
    "★ generate 返回 data.id 即任务号；结果在 POST /api/feed/creation/search/my 的 data.feeds[] 里按 commonInfo.id 匹配，status 2=Completed / 6=Failed / 1=InProgress / 3=NeedCharge。",
    "★ 更正（R88）：/api/feed/* 的「404 page not found」不是上游抖动，是**我自己脚本把 body 拼进 URL** 造成的；URL 正确后每次 200。轮询仍保留重试（幂等只读）。",
    "★ 成本口径：credit 单价按 equity.modelControl[].videoCosts 的 resolutionTypeList 映射（例：nano-banana2 1K/2K=6 credit，4K=10 credit）。",
    "★ 海螺网页端**没有签到领额度接口**：checkin 语义=同步一次余额，delta 恒 0，靠退避收敛（H3P_CHECKIN_MS）。"
  ],
  "name": "hailuo-web",
  "base": "https://hailuoai.com",
  "auth": {
    "type": "hailuo_web"
  },
  "endpoints": {
    "wallet": {
      "method": "GET",
      "path": "/v1/api/billing/credit",
      "map": {
        "credits": "data.total_credit"
      }
    },
    "checkin": {
      "method": "GET",
      "path": "/v1/api/billing/credit",
      "map": {
        "credits_before": "data.total_credit",
        "credits_after": "data.total_credit"
      }
    },
    "task": {
      "method": "POST",
      "path": "/v2/api/multimodal/generate/image",
      "async": true,
      "body": {
        "quantity": "{{n:quantity}}",
        "parameter": {
          "modelID": "all-in-one-image-pro",
          "desc": "{{prompt}}",
          "fileList": [],
          "useOriginPrompt": true,
          "aspectRatio": "{{aspectRatio}}",
          "resolution": "{{resolution}}",
          "quality": "{{quality}}",
          "referenceMode": ""
        },
        "projectID": "0"
      },
      "models": {
        "all-in-one-image-pro": {
          "modelID": "all-in-one-image-pro",
          "resolution": "1K",
          "aspectRatio": "Auto",
          "quality": "medium",
          "cost": 6,
          "body": {
            "quantity": "{{n:quantity}}",
            "parameter": {
              "modelID": "all-in-one-image-pro",
              "desc": "{{prompt}}",
              "fileList": [],
              "useOriginPrompt": true,
              "aspectRatio": "{{aspectRatio}}",
              "resolution": "{{resolution}}",
              "quality": "{{quality}}",
              "referenceMode": ""
            },
            "projectID": "0"
          }
        },
        "seedream-4.5": {
          "modelID": "seedream-4.5",
          "resolution": "2K",
          "aspectRatio": "Auto",
          "quality": "medium",
          "cost": 4,
          "body": {
            "quantity": "{{n:quantity}}",
            "parameter": {
              "modelID": "seedream-4.5",
              "desc": "{{prompt}}",
              "fileList": [],
              "useOriginPrompt": true,
              "aspectRatio": "{{aspectRatio}}",
              "resolution": "{{resolution}}",
              "quality": "{{quality}}",
              "referenceMode": ""
            },
            "projectID": "0"
          }
        },
        "gpt-image-1.5": {
          "modelID": "gpt-image-1.5",
          "resolution": "Medium",
          "aspectRatio": "Auto",
          "quality": "medium",
          "cost": 8,
          "body": {
            "quantity": "{{n:quantity}}",
            "parameter": {
              "modelID": "gpt-image-1.5",
              "desc": "{{prompt}}",
              "fileList": [],
              "useOriginPrompt": true,
              "aspectRatio": "{{aspectRatio}}",
              "resolution": "{{resolution}}",
              "quality": "{{quality}}",
              "referenceMode": ""
            },
            "projectID": "0"
          }
        },
        "image-01": {
          "modelID": "image-01",
          "cost": 1,
          "body": {
            "quantity": "{{n:quantity}}",
            "parameter": {
              "modelID": "image-01",
              "desc": "{{prompt}}",
              "fileList": [],
              "useOriginPrompt": true
            },
            "projectID": "0"
          }
        },
        "MiniMax-Image": {
          "modelID": "all-in-one-image-pro",
          "resolution": "1K",
          "aspectRatio": "Auto",
          "quality": "medium",
          "cost": 6,
          "body": {
            "quantity": "{{n:quantity}}",
            "parameter": {
              "modelID": "all-in-one-image-pro",
              "desc": "{{prompt}}",
              "fileList": [],
              "useOriginPrompt": true,
              "aspectRatio": "{{aspectRatio}}",
              "resolution": "{{resolution}}",
              "quality": "{{quality}}",
              "referenceMode": ""
            },
            "projectID": "0"
          }
        }
      },
      "map": {
        "task_id": "data.id"
      }
    },
    "query": {
      "method": "POST",
      "path": "/api/feed/creation/search/my",
      "body": {
        "cursor": "",
        "limit": "{{n:limit}}"
      },
      "map": {
        "list_path": "data.feeds",
        "id_path": "commonInfo.id",
        "status_path": "commonInfo.status",
        "url_path": [
          "metaInfo.imageMetaInfo.mediaInfo.downloadURL.aiWatermarkURL",
          "metaInfo.imageMetaInfo.mediaInfo.downloadURL.hailuoWatermarkURL",
          "metaInfo.imageMetaInfo.mediaInfo.downloadURL.watermarkURL",
          "metaInfo.imageMetaInfo.mediaInfo.url"
        ],
        "cover_path": "feedCoverInfo.coverURL"
      }
    }
  }
}
