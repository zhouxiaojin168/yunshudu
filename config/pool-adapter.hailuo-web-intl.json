  "name": "hailuo-web-intl",
  "base": "https://hailuoai.video",
  "auth": {
    "type": "hailuo_web"
  },
  "endpoints": {
    "wallet": {
      "method": "GET",
      "path": "/v1/api/billing/credit",
      "map": {
        "credits": "data.total_credit"
      }
    },
    "checkin": {
      "method": "GET",
      "path": "/v1/api/billing/credit",
      "map": {
        "credits_before": "data.total_credit",
        "credits_after": "data.total_credit"
      }
    },
    "task": {
      "method": "POST",
      "path": "/v2/api/multimodal/generate/image",
      "async": true,
      "body": {
        "quantity": "{{n:quantity}}",
        "parameter": {
          "modelID": "nano-banana2",
          "desc": "{{prompt}}",
          "fileList": [],
          "useOriginPrompt": true,
          "aspectRatio": "{{aspectRatio}}",
          "resolution": "{{resolution}}",
          "quality": "{{quality}}",
          "referenceMode": ""
        },
        "projectID": "0"
      },
      "models": {
        "nano-banana2": {
          "modelID": "nano-banana2",
          "resolution": "1K",
          "aspectRatio": "Auto",
          "quality": "medium",
          "cost": 6,
          "body": {
            "quantity": "{{n:quantity}}",
            "parameter": {
              "modelID": "nano-banana2",
              "desc": "{{prompt}}",
              "fileList": [],
              "useOriginPrompt": true,
              "aspectRatio": "{{aspectRatio}}",
              "resolution": "{{resolution}}",
              "quality": "{{quality}}",
              "referenceMode": ""
            },
            "projectID": "0"
          }
        },
        "seedream-4.5": {
          "modelID": "seedream-4.5",
          "resolution": "2K",
          "aspectRatio": "Auto",
          "quality": "medium",
          "cost": 4,
          "body": {
            "quantity": "{{n:quantity}}",
            "parameter": {
              "modelID": "seedream-4.5",
              "desc": "{{prompt}}",
              "fileList": [],
              "useOriginPrompt": true,
              "aspectRatio": "{{aspectRatio}}",
              "resolution": "{{resolution}}",
              "quality": "{{quality}}",
              "referenceMode": ""
            },
            "projectID": "0"
          }
        },
        "gpt-image-1.5": {
          "modelID": "gpt-image-1.5",
          "resolution": "Medium",
          "aspectRatio": "Auto",
          "quality": "medium",
          "cost": 8,
          "body": {
            "quantity": "{{n:quantity}}",
            "parameter": {
              "modelID": "gpt-image-1.5",
              "desc": "{{prompt}}",
              "fileList": [],
              "useOriginPrompt": true,
              "aspectRatio": "{{aspectRatio}}",
              "resolution": "{{resolution}}",
              "quality": "{{quality}}",
              "referenceMode": ""
            },
            "projectID": "0"
          }
        },
        "image-01": {
          "modelID": "image-01",
          "cost": 1,
          "body": {
            "quantity": "{{n:quantity}}",
            "parameter": {
              "modelID": "image-01",
              "desc": "{{prompt}}",
              "fileList": [],
              "useOriginPrompt": true
            },
            "projectID": "0"
          }
        }
      },
      "map": {
        "task_id": "data.id"
      }
    },
    "query": {
      "method": "POST",
      "path": "/api/feed/creation/search/my",
      "body": {
        "cursor": "",
        "limit": "{{n:limit}}"
      },
      "map": {
        "list_path": "data.feeds",
        "id_path": "commonInfo.id",
        "status_path": "commonInfo.status",
        "url_path": "metaInfo.imageMetaInfo.mediaInfo.url",
        "cover_path": "feedCoverInfo.coverURL"
      }
    }
  }
}
