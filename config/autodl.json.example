  "$comment": "自建 4090D 实例的电源管理配置。复制成 C:\\yunshudu\\config\\autodl.json 填好再 enabled:true。",
  "$why": "AutoDL 按小时计费（本机 ¥2.93/h），没人用的时候自动关机 = 直接省钱。",
  "enabled": false,
  "dry_run": true,
  "api_base": "https://api.autodl.com",
