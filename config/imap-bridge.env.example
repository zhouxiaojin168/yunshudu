# imap-mail-bridge 环境变量模板（零依赖 IMAP 收信桥）
# 用法：把本文件复制成 config/imap-bridge.env，填好后由启动脚本读取；
#       或直接作为计划任务的进程环境变量注入。
# 目标：让 pool-supply 只改一个 SUPP_MAIL_API 就切到真实邮箱收码。

# ---- IMAP 连接（以 Spacemail 为例；其他邮箱换成自家主机/端口）----
IMB_HOST=mail.spacemail.com
IMB_PORT=993
IMB_TLS=1
IMB_TLS_INSECURE=0

# ---- 邮箱账号（真实凭据不要提交到 git）----
IMB_USER=yipian@qingzhou.autos
IMB_PASS=

# ---- 对外生成的收信地址 ----
IMB_DOMAIN=qingzhou.autos
IMB_PREFIX=hl
# 若走 Spacemail 单邮箱 + 别名（非 catch-all），把已建好的别名列在这里，按顺序轮用：
IMB_ALIASES=
# 1 = 不做收件人匹配，任何新邮件都算命中（排障用，生产建议 0）
IMB_ALLOW_ANY=0
IMB_FOLDER=INBOX

# ---- HTTP 服务 ----
IMB_HTTP_HOST=127.0.0.1
IMB_HTTP_PORT=8098
IMB_API_KEY=

# ---- 轮询与扫描 ----
IMB_POLL_MS=3000
IMB_MAX_SCAN=40
IMB_LOOKBACK_H=24
IMB_MARK_SEEN=0
