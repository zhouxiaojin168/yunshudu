          "quality": "medium",
          "cost": 6,
          "body": {
            "quantity": "{{n:quantity}}",
            "parameter": {
              "modelID": "all-in-one-image-pro",
              "desc": "{{prompt}}",
              "fileList": [],
              "useOriginPrompt": true,
