  "endpoints": {
    "wallet": {
      "method": "GET",
      "path": "/v1/api/billing/credit",
      "map": {
        "credits": "data.total_credit"
      }
    },
    "checkin": {
      "method": "GET",
      "path": "/v1/api/billing/credit",
      "map": {
        "credits_before": "data.total_credit",
        "credits_after": "data.total_credit"
      }
    },
    "task": {
      "method": "POST",
      "path": "/v2/api/multimodal/generate/image",
      "async": true,
      "body": {
        "quantity": "{{n:quantity}}",
        "parameter": {
          "modelID": "all-in-one-image-pro",
          "desc": "{{prompt}}",
          "fileList": [],
          "useOriginPrompt": true,
          "aspectRatio": "{{aspectRatio}}",
          "resolution": "{{resolution}}",
          "quality": "{{quality}}",
          "referenceMode": ""
        },
        "projectID": "0"
      },
      "map": {
        "task_id": "data.id"
      }
    },
    "query": {
      "method": "POST",
      "path": "/api/feed/creation/search/my",
      "body": {
        "cursor": "",
        "limit": "{{n:limit}}"
      },
      "map": {
        "list_path": "data.feeds",
        "id_path": "commonInfo.id",
        "status_path": "commonInfo.status",
        "url_path": [
          "metaInfo.imageMetaInfo.mediaInfo.downloadURL.aiWatermarkURL",
          "metaInfo.imageMetaInfo.mediaInfo.downloadURL.hailuoWatermarkURL",
          "metaInfo.imageMetaInfo.mediaInfo.downloadURL.watermarkURL",
          "metaInfo.imageMetaInfo.mediaInfo.url"
        ],
        "cover_path": "feedCoverInfo.coverURL"
      }
    }
  },
  "_verify": [
    "★R113 生产实测(国内站 cn)：all-in-one-image-pro 1K/Auto/medium -> 200 code=0；池子端到端 33s 回填真图 URL。",
    "★R88 生产实测(海外站 intl)：nano-banana2 -> 200 code=0，扣 6 credits。",
    "★R114：/v1/api/task/list /user/sign_in /user/checkin 等签到类接口全部 404 -> 海螺无「每日签到领额度」；credit 是新人一次性礼。"
  ],
  "_http_notes": [
    "★ resolution/aspectRatio/quality 必须是 valueStr 字符串（发数字会 HTTP 400 bind body failed）。",
    "★ generate 返回 data.id 即任务号；结果在 POST /api/feed/creation/search/my 的 data.feeds[] 按 commonInfo.id 匹配，status 2=完成/6=失败/1=进行中。"
  ]
}
