{
  "_note": "沙箱上游服务条目（已从 services.json 摘掉）。要恢复本地/服务器演练：把 services 数组里的这段加回 services.json 再提交部署即可。",
  "_why": "接真上游后它只会空转，所以摘掉；但保留条目方便随时做端到端演练。",
  "service": {
    "name": "h3-mock-official",
    "type": "node",
    "task": "yunshudu-h3-mock",
    "managed": "auto",
    "port": 9941,
    "critical": false,
    "node": "node-v22.23.3\\node.exe",
    "script": "app\\scripts\\mock-official.js",
    "scriptArgs": [],
    "launcher": "app\\deploy\\run-service.ps1",
    "launcherArgs": [
      "-Name",
      "h3-mock-official"
    ],
    "env": {
      "OFFICIAL_PORT": "9941",
      "OFFICIAL_DAILY_CREDITS": "300"
    },
    "health": {
      "kind": "http",
      "url": "http://127.0.0.1:9941/healthz",
      "expect": 200,
      "timeoutSec": 5,
      "retries": 10,
      "intervalSec": 2
    },
    "note": "★沙箱上游（仅演练，临时保留）：阶段B 会从清单里摘掉。",
    "restartOnDeploy": true
  }
}
