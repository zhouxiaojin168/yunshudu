# ---- 运行期产物：不入库（runtime 下只放行 checksums）----
runtime/*
!runtime/checksums-windows.txt

# ---- 二进制/大文件 ----
*.exe
*.db
*.db-wal
*.db-shm
*.log
*.pid

# ---- 依赖/临时 ----
node_modules/
__pycache__/
*.tmp
.DS_Store
Thumbs.db
# ---- 账号池运行态/私密数据：绝不入库 ----
state/
config/*.local.json

# ---- 临时调试脚本 ----
scripts/_dbg-*.js