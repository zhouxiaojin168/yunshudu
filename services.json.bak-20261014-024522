{
  "version": 1,
  "root": "C:\\yunshudu",
  "note": "服务器侧服务清单：post-deploy.ps1 读本文件逐个确保服务存活；run-service.ps1 按名字启动单个服务。health.kind 支持 http / tcp / file。",
  "services": [
    {
      "name": "new-api",
      "type": "exe",
      "task": "yunshudu-new-api",
      "managed": "external",
      "port": 3000,
      "critical": true,
      "launcher": "run-new-api.ps1",
      "launcherArgs": [],
      "health": {
        "kind": "http",
        "url": "http://127.0.0.1:3000/api/status",
        "expect": 200,
        "timeoutSec": 5,
        "retries": 15,
        "intervalSec": 2
      },
      "restartOnDeploy": false,
      "restartOnDeployNote": "二进制在仓库外，重启会丢内存态，只在健康检查失败时重启"
    },
    {
      "name": "edge-proxy",
      "type": "node",
      "task": "yunshudu-edge",
      "managed": "auto",
      "port": 8080,
      "critical": false,
      "node": "node-v22.23.3\\node.exe",
      "script": "app\\scripts\\edge-proxy.js",
      "scriptArgs": [],
      "launcher": "app\\deploy\\run-service.ps1",
      "launcherArgs": [
        "-Name",
        "edge-proxy"
      ],
      "env": {
        "EDGE_PORT": "80,8080",
        "EDGE_HOST": "0.0.0.0",
        "EDGE_UPSTREAM": "http://127.0.0.1:3000",
        "EDGE_LOG_DIR": "C:\\yunshudu\\logs",
        "EDGE_RL_MAX": "1200",
        "EDGE_ACCESS_LOG": "0",
        "EDGE_ROUTES": "/mailfarm=http://127.0.0.1:8099"
      },
      "health": {
        "kind": "http",
        "url": "http://127.0.0.1:8080/__edge/health",
        "expect": 200,
        "timeoutSec": 5,
        "retries": 10,
        "intervalSec": 2
      },
      "ports": [
        80,
        8080
      ],
      "note": "机房公网 80 被透明截持（Apache 301 -> 183.136.132.24），故同时听 8080；80 留待备案/解封。EDGE_RL_MAX=每IP每分钟上限（0=不限流）；EDGE_ACCESS_LOG=1 记录每条请求（默认只记慢请求和错误） 新增 EDGE_ROUTES：/mailfarm/* -> 127.0.0.1:8099（mailfarm），这样 Cloudflare Email Worker 可直接 POST 到 <隧道域名>/mailfarm/v1/ingest，无需开新端口。",
      "restartOnDeploy": true,
      "restartOnDeployNote": "仓库内脚本变更后必须重启才能生效"
    },
    {
      "name": "cloudflared",
      "type": "exe",
      "task": "yunshudu-tunnel",
      "managed": "auto",
      "critical": false,
      "script": "bin\\cloudflared.exe",
      "scriptArgs": [
        "tunnel",
        "--no-autoupdate",
        "--metrics",
        "127.0.0.1:29731",
        "--url",
        "http://127.0.0.1:8080"
      ],
      "launcher": "app\\deploy\\run-service.ps1",
      "launcherArgs": [
        "-Name",
        "cloudflared"
      ],
      "note": "免账号快速隧道 -> 公网 HTTPS 域名，绕开机房 80 截持；URL 落 logs\\cloudflared.err.log，由 tunnel-watch 抓取",
      "health": {
        "kind": "http",
        "url": "http://127.0.0.1:29731/ready",
        "expect": 200,
        "timeoutSec": 5,
        "retries": 15,
        "intervalSec": 3
      },
      "restartOnDeploy": false,
      "restartOnDeployNote": "重启会更换临时隧道域名，只在健康检查失败时重启"
    },
    {
      "name": "tunnel-watch",
      "type": "node",
      "task": "yunshudu-tunnel-watch",
      "managed": "auto",
      "critical": false,
      "node": "node-v22.23.3\\node.exe",
      "script": "app\\scripts\\tunnel-watch.js",
      "scriptArgs": [],
      "launcher": "app\\deploy\\run-service.ps1",
      "launcherArgs": [
        "-Name",
        "tunnel-watch"
      ],
      "env": {
        "TW_ROOT": "C:\\yunshudu",
        "TW_LOG": "C:\\yunshudu\\logs\\cloudflared.err.log",
        "TW_STATE": "C:\\yunshudu\\state\\tunnel-url.txt",
        "TW_API": "http://127.0.0.1:3000",
        "TW_INTERVAL": "20"
      },
      "note": "每 20s 扫 cloudflared 日志抓临时域名 -> 写 state\\tunnel-url.txt + 同步站点 ServerAddress（密码从 secrets.txt 的 ADMIN_PASSWORD 读，不入库）",
      "health": {
        "kind": "file",
        "path": "C:\\yunshudu\\state\\tunnel-url.txt",
        "maxAgeSec": 300,
        "retries": 10,
        "intervalSec": 3
      },
      "restartOnDeploy": true,
      "restartOnDeployNote": "仓库内脚本变更后必须重启才能生效"
    },
    {
      "name": "portal",
      "type": "node",
      "task": "yunshudu-portal",
      "managed": "auto",
      "port": 8899,
      "critical": false,
      "node": "node-v22.23.3\\node.exe",
      "script": "app\\scripts\\serve-web.js",
      "scriptArgs": [
        "8899"
      ],
      "launcher": "app\\deploy\\run-service.ps1",
      "launcherArgs": [
        "-Name",
        "portal"
      ],
      "env": {
        "WEB_PORT": "8899",
        "API_HOST": "127.0.0.1",
        "API_PORT": "3000"
      },
      "note": "静态门户（web/）+ /api 反代到 new-api(3000)；无需上游 key，服务器自带一个可用的展示站",
      "health": {
        "kind": "http",
        "url": "http://127.0.0.1:8899/",
        "expect": 200,
        "timeoutSec": 5,
        "retries": 10,
        "intervalSec": 2
      },
      "restartOnDeploy": true,
      "restartOnDeployNote": "仓库内脚本变更后必须重启才能生效"
    },
