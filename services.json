{
  "version": 1,
  "root": "C:\\yunshudu",
  "note": "服务器侧服务清单：post-deploy.ps1 读本文件逐个确保服务存活；run-service.ps1 按名字启动单个服务。health.kind 支持 http / tcp / file。",
  "services": [
    {
      "name": "new-api",
      "type": "exe",
      "task": "yunshudu-new-api",
      "managed": "external",
      "port": 3000,
      "critical": true,
      "launcher": "run-new-api.ps1",
      "launcherArgs": [],
      "health": {
        "kind": "http",
        "url": "http://127.0.0.1:3000/api/status",
        "expect": 200,
        "timeoutSec": 5,
        "retries": 15,
        "intervalSec": 2
      },
      "restartOnDeploy": false,
      "restartOnDeployNote": "二进制在仓库外，重启会丢内存态，只在健康检查失败时重启"
    },
    {
      "name": "edge-proxy",
      "type": "node",
      "task": "yunshudu-edge",
      "managed": "auto",
      "port": 8080,
      "critical": false,
      "node": "node-v22.23.3\\node.exe",
      "script": "app\\scripts\\edge-proxy.js",
      "scriptArgs": [],
      "launcher": "app\\deploy\\run-service.ps1",
      "launcherArgs": [
        "-Name",
        "edge-proxy"
      ],
      "env": {
        "EDGE_PORT": "80,8080",
        "EDGE_HOST": "0.0.0.0",
        "EDGE_UPSTREAM": "http://127.0.0.1:3000",
        "EDGE_LOG_DIR": "C:\\yunshudu\\logs",
        "EDGE_RL_MAX": "1200",
        "EDGE_ACCESS_LOG": "0"
      },
      "health": {
        "kind": "http",
        "url": "http://127.0.0.1:8080/__edge/health",
        "expect": 200,
        "timeoutSec": 5,
        "retries": 10,
        "intervalSec": 2
      },
      "ports": [
        80,
        8080
      ],
      "note": "机房公网 80 被透明截持（Apache 301 -> 183.136.132.24），故同时听 8080；80 留待备案/解封。EDGE_RL_MAX=每IP每分钟上限（0=不限流）；EDGE_ACCESS_LOG=1 记录每条请求（默认只记慢请求和错误）",
      "restartOnDeploy": true,
      "restartOnDeployNote": "仓库内脚本变更后必须重启才能生效"
    },
    {
      "name": "cloudflared",
      "type": "exe",
      "task": "yunshudu-tunnel",
      "managed": "auto",
      "critical": false,
      "script": "bin\\cloudflared.exe",
      "scriptArgs": [
        "tunnel",
        "--no-autoupdate",
        "--metrics",
        "127.0.0.1:29731",
        "--url",
        "http://127.0.0.1:8080"
      ],
      "launcher": "app\\deploy\\run-service.ps1",
      "launcherArgs": [
        "-Name",
        "cloudflared"
      ],
      "note": "免账号快速隧道 -> 公网 HTTPS 域名，绕开机房 80 截持；URL 落 logs\\cloudflared.err.log，由 tunnel-watch 抓取",
      "health": {
        "kind": "http",
        "url": "http://127.0.0.1:29731/ready",
        "expect": 200,
        "timeoutSec": 5,
        "retries": 15,
        "intervalSec": 3
      },
      "restartOnDeploy": false,
      "restartOnDeployNote": "重启会更换临时隧道域名，只在健康检查失败时重启"
    },
    {
      "name": "tunnel-watch",
      "type": "node",
      "task": "yunshudu-tunnel-watch",
      "managed": "auto",
      "critical": false,
      "node": "node-v22.23.3\\node.exe",
      "script": "app\\scripts\\tunnel-watch.js",
      "scriptArgs": [],
      "launcher": "app\\deploy\\run-service.ps1",
      "launcherArgs": [
        "-Name",
        "tunnel-watch"
      ],
      "env": {
        "TW_ROOT": "C:\\yunshudu",
        "TW_LOG": "C:\\yunshudu\\logs\\cloudflared.err.log",
        "TW_STATE": "C:\\yunshudu\\state\\tunnel-url.txt",
        "TW_API": "http://127.0.0.1:3000",
        "TW_INTERVAL": "20"
      },
      "note": "每 20s 扫 cloudflared 日志抓临时域名 -> 写 state\\tunnel-url.txt + 同步站点 ServerAddress（密码从 secrets.txt 的 ADMIN_PASSWORD 读，不入库）",
      "health": {
        "kind": "file",
        "path": "C:\\yunshudu\\state\\tunnel-url.txt",
        "maxAgeSec": 300,
        "retries": 10,
        "intervalSec": 3
      },
      "restartOnDeploy": true,
      "restartOnDeployNote": "仓库内脚本变更后必须重启才能生效"
    },
    {
      "name": "portal",
      "type": "node",
      "task": "yunshudu-portal",
      "managed": "auto",
      "port": 8899,
      "critical": false,
      "node": "node-v22.23.3\\node.exe",
      "script": "app\\scripts\\serve-web.js",
      "scriptArgs": [
        "8899"
      ],
      "launcher": "app\\deploy\\run-service.ps1",
      "launcherArgs": [
        "-Name",
        "portal"
      ],
      "env": {
        "WEB_PORT": "8899",
        "API_HOST": "127.0.0.1",
        "API_PORT": "3000"
      },
      "note": "静态门户（web/）+ /api 反代到 new-api(3000)；无需上游 key，服务器自带一个可用的展示站",
      "health": {
        "kind": "http",
        "url": "http://127.0.0.1:8899/",
        "expect": 200,
        "timeoutSec": 5,
        "retries": 10,
        "intervalSec": 2
      },
      "restartOnDeploy": true,
      "restartOnDeployNote": "仓库内脚本变更后必须重启才能生效"
    },
    {
      "name": "h3-platform-pool",
      "type": "node",
      "task": "yunshudu-h3pool",
      "managed": "auto",
      "port": 9940,
      "critical": false,
      "node": "node-v22.23.3\\node.exe",
      "script": "app\\scripts\\h3-platform-pool.js",
      "scriptArgs": [],
      "launcher": "app\\deploy\\run-service.ps1",
      "launcherArgs": [
        "-Name",
        "h3-platform-pool"
      ],
      "env": {
        "H3P_PORT": "9940",
        "H3P_DB": "C:\\yunshudu\\data\\h3pool.db",
        "H3P_CHECKIN_MS": "60000",
        "H3P_DAILY_CREDITS": "300",
        "H3P_ADAPTER_FILE": "C:\\yunshudu\\app\\config\\pool-adapter.hailuo-web-intl.json",
        "H3P_POLL_MS": "5000"
      },
      "envFrom": {
        "H3P_ADMIN_KEY": "H3P_ADMIN_KEY"
      },
      "health": {
        "kind": "http",
        "url": "http://127.0.0.1:9940/healthz",
        "expect": 200,
        "timeoutSec": 5,
        "retries": 10,
        "intervalSec": 2
      },
      "note": "账号池引擎（服务端账号池）：N 个上游账号汇成一个池，按「最肥优先 + 预占 + 402 换号 + 定时签到」对外供算力。上游接口全在 config/pool-adapter.<x>.json 里（base/path/auth/map/body 模板/models 参数映射），换上游不动代码；管理密钥从 secrets.txt 的 H3P_ADMIN_KEY 读。当前指向乙路-海外站 hailuoai.video（R88 生产跑通：灌号->出图->轮询回填真图 URL）。",
      "restartOnDeploy": true,
      "restartOnDeployNote": "仓库内脚本变更后必须重启才能生效"
    },
    {
      "name": "pool-supply",
      "type": "node",
      "task": "yunshudu-pool-supply",
      "managed": "auto",
      "port": 9950,
      "critical": false,
      "node": "node-v22.23.3\\node.exe",
      "script": "app\\scripts\\pool-supply.js",
      "scriptArgs": [],
      "launcher": "app\\deploy\\run-service.ps1",
      "launcherArgs": [
        "-Name",
        "pool-supply"
      ],
      "env": {
        "SUPP_PORT": "9950",
        "SUPP_POOL_API": "http://127.0.0.1:9940",
        "SUPP_POOL_MIN": "5",
        "SUPP_POOL_MAX": "200",
        "SUPP_FARM_FILE": "C:\\yunshudu\\data\\farm-accounts.jsonl",
        "SUPP_REGISTER_FILE": "C:\\yunshudu\\app\\config\\pool-register.json",
        "SUPP_STATE_FILE": "C:\\yunshudu\\state\\pool-supply.json",
        "SUPP_LOG_FILE": "C:\\yunshudu\\logs\\pool-supply.log",
        "SUPP_MAIL_API": "http://127.0.0.1:8099",
        "SUPP_MAIL_PREFIX": "hl",
        "SUPP_MAIL_WAIT_MS": "90000"
      },
      "envFrom": {
        "SUPP_POOL_ADMIN_KEY": "H3P_ADMIN_KEY",
        "SUPP_ADMIN_KEY": "H3P_ADMIN_KEY",
        "SUPP_MAIL_KEY": "MAILFARM_API_KEY"
      },
      "health": {
        "kind": "http",
        "url": "http://127.0.0.1:9950/supply/healthz",
        "expect": 200,
        "timeoutSec": 5,
        "retries": 10,
        "intervalSec": 2
      },
      "note": "「无限算力」的补给站：健康账号数低于下限就自动补号（农场文件 / 注册工作流 / 接码平台），并定时全池签到把免费额度拿满。管理面 /supply/stats|guard|checkin|import|register。 已接入 mailfarm 邮箱补号（type=mail-acquire/mail-wait，见 config/pool-register.mailfarm.json）：邮箱制上游可零短信成本开号。",
      "restartOnDeploy": true,
      "restartOnDeployNote": "仓库内脚本变更后必须重启才能生效"
    },
    {
      "name": "mailfarm",
      "type": "node",
      "task": "yunshudu-mailfarm",
      "managed": "auto",
      "port": 8099,
      "critical": false,
      "node": "node-v22.23.3\\node.exe",
      "script": "app\\scripts\\mailfarm-server.js",
      "scriptArgs": [],
      "launcher": "app\\deploy\\run-service.ps1",
      "launcherArgs": [
        "-Name",
        "mailfarm"
      ],
      "env": {
        "MF_SERVICE_NAME": "mailfarm",
        "MF_DOMAINS": "allen23.online,jixuwz.com,lopwi.cyou,sghd.college,ytu.baby",
        "MF_HTTP_HOST": "0.0.0.0",
        "MF_HTTP_PORT": "8099",
        "MF_SMTP_ENABLE": "0",
        "MF_MAILBOX_TTL_S": "3600",
        "MF_CODE_MAX_AGE_S": "900"
      },
      "envFrom": {
        "MF_API_KEY": "MAILFARM_API_KEY",
        "MF_INGEST_KEY": "MAILFARM_INGEST_KEY"
      },
      "health": {
        "kind": "http",
        "url": "http://127.0.0.1:8099/healthz",
        "expect": 200,
        "timeoutSec": 5,
        "retries": 10,
        "intervalSec": 2
      },
      "note": "一次性收件箱/邮箱农场（零依赖 Node 版）：自有域名 catch-all 发号 + 自动取验证码，给注册机用。机房封 25，故 MF_SMTP_ENABLE=0，改走 POST /v1/ingest（Cloudflare Email Routing + Email Worker 转发到隧道域名）或 Postfix pipe。对外暴露走已有 cloudflared 隧道，别指望机房放行 25。",
      "restartOnDeploy": true,
      "restartOnDeployNote": "仓库内脚本变更后必须重启才能生效"
    }
  ],
  "restartOnDeployDoc": "restartOnDeploy=true: 每次部署都硬重启该服务（用于仓库内的 Node 脚本，保证新代码生效）。false/缺省: 仅当健康检查失败才重启。"
}
